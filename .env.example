# Copy this file to .env. Leave API keys empty until you have credentials.
# Docker Compose reads .env automatically. Host Python uses localhost URLs below.
INSTALL_OPTIONAL_DEPS=0
INSTALL_FLYAI_CLI=0

# Chat model (required for /api/v1/chat)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
# Set json_object for gateways without strict JSON Schema support.
PLANNER_RESPONSE_FORMAT=json_schema
PLANNER_TIMEOUT_SECONDS=30

# Embedding model (required for knowledge ingestion, search, and grounded RAG).
# If the chat provider/key supports embeddings, EMBEDDING_API_KEY may remain empty.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_MAX_TOKENS=8192
EMBEDDING_CHUNK_MAX_TOKENS=7000

# Local infrastructure. Docker Compose supplies container-specific URLs itself.
DATABASE_URL=postgresql+asyncpg://travel:travel@localhost:5432/travel
REDIS_URL=redis://localhost:6379/0
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Inventory: demo needs no supplier account; use flyai or amadeus for live data.
TRAVEL_INVENTORY_PROVIDER=demo
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com
FLYAI_CLI_BIN=flyai
FLYAI_API_KEY=
FLYAI_TIMEOUT_S=45
TRAVEL_SEARCH_MAX_RESULTS=5

# Bundled 12306 script is used by default. Node.js >=18 and network are required.
# For remote MCP instead, set RAILWAY_12306_SKILL_DIR= (empty) and RAILWAY_MCP_URL.
# Docker Compose always uses /app/external/12306 for the bundled script.
RAILWAY_MCP_URL=
RAILWAY_MCP_TIMEOUT_S=30

AGENT_ORCHESTRATOR_BACKEND=langgraph
TRAVEL_VALIDATION_MAX_RETRIES=1
TASK_MAX_CONCURRENCY=3
TASK_TIMEOUT_SECONDS=120
MEMORY_WINDOW_SIZE=20
MEMORY_SUMMARY_THRESHOLD=15
MEMORY_MAX_MESSAGES=40
MEMORY_SESSION_TTL_SECONDS=86400

RAG_KEYWORD_TOP_K=20
RAG_VECTOR_TOP_K=20
RAG_RRF_K=60
RAG_FUSED_TOP_K=20
RAG_FINAL_TOP_K=5
# Evidence coverage, drafting and semantic verification reuse OPENAI_* credentials.
RAG_EVIDENCE_TIMEOUT_SECONDS=120
# 多任务模式下，每个制度问答任务的总超时（含检索、整理、草稿、核验和校正）。
RAG_EVIDENCE_TASK_TIMEOUT_SECONDS=360
RAG_EVIDENCE_MAX_SUPPLEMENTAL_QUERIES=1
RAG_EVIDENCE_CHUNK_MAX_CHARS=8000
RAG_SEMANTIC_PDF_ENABLED=true
RAG_SEMANTIC_MIN_CHARS=100
RAG_SEMANTIC_TARGET_CHARS=180
RAG_SEMANTIC_MAX_CHARS=300
RAG_RERANKER_ENABLED=false
# Model Studio native text-rerank endpoint; use a key from the same workspace.
RAG_RERANKER_API_KEY=
RAG_RERANKER_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RAG_RERANKER_MODEL=qwen3.7-text-rerank
KEYWORD_INDEX_REDIS_KEY=knowledge:keyword:chunks
LOG_LEVEL=INFO
